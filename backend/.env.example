# Async Postgres URL. Railway gives you a sync URL; either form is accepted
# and normalized to postgresql+asyncpg:// in app/config.py.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# 32+ char secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Token lifetimes
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# First boot creates this admin if the users table is empty. Leave the
# password blank to get an auto-generated one in the Railway logs.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Comma-separated CORS origins. Frontend GitHub Pages URL is included by default.
ALLOWED_ORIGINS=https://sashaok123.github.io,http://localhost:8000

# Path to the seed canvas JSON. Relative paths resolve against backend/.
CANVAS_SEED_PATH=../data/canvas.canvas

# production / development. Development auto-creates tables without alembic.
ENV=production
